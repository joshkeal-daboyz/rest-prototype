{
  "name": "rest-circuits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "tsc --noEmit && vitest run --changed origin/main",
    "gate:full": "tsc --noEmit && vitest run --mode full && vitest run --config vitest.report.config.ts",
    "report": "vitest run --config vitest.report.config.ts",
    "analyze": "tsx tools/analyze.ts",
    "assets:convert": "tsx tools/assets/convert.ts",
    "assets:selftest": "tsx tools/assets/convert.ts --selftest",
    "assets:game": "tsx tools/assets/game.ts",
    "build:itch": "tsx tools/itch/run.ts",
    "check": "tsx tools/check.ts",
    "fit": "tsx tools/fitrun.ts",
    "playtest": "tsc --noEmit -p tests/playtest/tsconfig.json && vitest run --config tests/playtest/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
